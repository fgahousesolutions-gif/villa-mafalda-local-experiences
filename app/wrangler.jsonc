{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "villa-mafalda-simonetta",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none"},
  "vars": {"EMAIL_MODE": "disabled", "RETENTION_DAYS": "180", "TOKEN_HOURS": "168", "PRIVACY_READY": "false"},
  "d1_databases": [{"binding": "DB", "database_name": "villa-mafalda-simonetta", "database_id": "REPLACE_BEFORE_RELEASE", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["*/5 * * * *"]}
}
